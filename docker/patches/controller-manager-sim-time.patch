+
+// Workbench regression: DDS /clock latency must not change embedded sim steps.
+class WorkbenchSimulationClock : public ControllerManagerFixture<controller_manager::ControllerManager>
+{
+public:
+  WorkbenchSimulationClock()
+  : ControllerManagerFixture(
+      "", "",
+      {rclcpp::Parameter("use_sim_time", true), rclcpp::Parameter("update_rate", 500)}) {}
+};
+
+TEST_F(WorkbenchSimulationClock, supplied_simulation_time_survives_delayed_ros_clock)
+{
+  class ClockProbe : public test_controller::TestController
+  {
+  public:
+    rclcpp::Time received{0, 0, RCL_ROS_TIME};
+    controller_interface::return_type update(
+      const rclcpp::Time & time, const rclcpp::Duration & period) override
+    {
+      received = time;
+      return TestController::update(time, period);
+    }
+  };
+  auto probe = std::make_shared<ClockProbe>();
+  cm_->add_controller(probe, "clock_probe", test_controller::TEST_CONTROLLER_CLASS_NAME);
+  ASSERT_EQ(cm_->configure_controller("clock_probe"), controller_interface::return_type::OK);
+  // Match the clock initialization normally performed by activate_controllers.
+  *cm_->get_loaded_controllers().front().last_update_cycle_time = rclcpp::Time(0, 0, RCL_ROS_TIME);
+  probe->get_node()->activate();
+  ASSERT_EQ(probe->get_lifecycle_state().id(), lifecycle_msgs::msg::State::PRIMARY_STATE_ACTIVE);
+  auto clock = cm_->get_clock()->get_clock_handle();
+  ASSERT_EQ(rcl_set_ros_time_override(clock, 900000000), RCL_RET_OK);
+  cm_->update(rclcpp::Time(1, 0, RCL_ROS_TIME), rclcpp::Duration(0, 2000000));
+  ASSERT_EQ(rcl_set_ros_time_override(clock, 901000000), RCL_RET_OK);
+  cm_->update(rclcpp::Time(1, 2000000, RCL_ROS_TIME), rclcpp::Duration(0, 2000000));
+  EXPECT_EQ(probe->received.nanoseconds(), 1002000000);
+  EXPECT_EQ(probe->update_period_.nanoseconds(), 2000000);
+}
