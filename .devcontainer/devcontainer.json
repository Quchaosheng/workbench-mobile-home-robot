{
  "name": "workbench-1 Ubuntu 24.04 ROS 2 Jazzy",
  "build": {
    "context": "..",
    "dockerfile": "../Dockerfile",
    "args": {
      "HTTP_PROXY": "${localEnv:WORKBENCH_BUILD_HTTP_PROXY}",
      "HTTPS_PROXY": "${localEnv:WORKBENCH_BUILD_HTTPS_PROXY}",
      "NO_PROXY": "${localEnv:WORKBENCH_BUILD_NO_PROXY}"
    }
  },
  "remoteUser": "workbench",
  "workspaceFolder": "/workspace/src",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/src,type=bind,consistency=cached,readonly",
  "mounts": [
    "source=workbench-dev-build,target=/workspace/build,type=volume",
    "source=workbench-dev-install,target=/workspace/install,type=volume",
    "source=workbench-dev-log,target=/workspace/log,type=volume"
  ],
  "postCreateCommand": "bash -lc 'source /opt/ros/jazzy/setup.bash && colcon --log-base /workspace/log build --base-paths /workspace/src/robot/control --build-base /workspace/build --install-base /workspace/install --merge-install --packages-select workbench_motion'",
  "forwardPorts": [8080],
  "containerEnv": {
    "WORKBENCH_OFFLINE": "1",
    "WORKBENCH_CONTAINER_PROFILE": "dashboard",
    "RMW_IMPLEMENTATION": "rmw_fastrtps_cpp",
    "ROS_DOMAIN_ID": "42",
    "ROS_AUTOMATIC_DISCOVERY_RANGE": "LOCALHOST"
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "ms-azuretools.vscode-docker"]
    }
  }
}
