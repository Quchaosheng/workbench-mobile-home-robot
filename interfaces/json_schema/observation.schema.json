            "belief": {"type": "string", "enum": ["inferred", "lost", "observed", "stale"]},
            "clock_id": {"type": "string", "enum": ["monotonic", "wall"]},
            "source": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"}
