              "door_state": {"type":"object","additionalProperties":false,"required":["observed_at","confidence","evidence_refs","belief"],"properties":{"observed_at":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[^\\u0000-\\u001f\\u007f-\\u009f]+$"},"confidence":{"type":"number","minimum":0,"maximum":1},"evidence_refs":{"type":"array","minItems":1,"maxItems":32,"items":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[^\\u0000-\\u001f\\u007f-\\u009f]+$"}},"belief":{"type":"string","enum":["inferred","lost","observed","stale"]},"clock_id":{"type":"string","enum":["monotonic","wall"]},"source":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[^\\u0000-\\u001f\\u007f-\\u009f]+$"}}},
              "identity": {"type":"object","additionalProperties":false,"required":["observed_at","confidence","evidence_refs","belief"],"properties":{"observed_at":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[^\\u0000-\\u001f\\u007f-\\u009f]+$"},"confidence":{"type":"number","minimum":0,"maximum":1},"evidence_refs":{"type":"array","minItems":1,"maxItems":32,"items":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[^\\u0000-\\u001f\\u007f-\\u009f]+$"}},"belief":{"type":"string","enum":["inferred","lost","observed","stale"]},"clock_id":{"type":"string","enum":["monotonic","wall"]},"source":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[^\\u0000-\\u001f\\u007f-\\u009f]+$"}}},
              "label_status": {"type":"object","additionalProperties":false,"required":["observed_at","confidence","evidence_refs","belief"],"properties":{"observed_at":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[^\\u0000-\\u001f\\u007f-\\u009f]+$"},"confidence":{"type":"number","minimum":0,"maximum":1},"evidence_refs":{"type":"array","minItems":1,"maxItems":32,"items":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[^\\u0000-\\u001f\\u007f-\\u009f]+$"}},"belief":{"type":"string","enum":["inferred","lost","observed","stale"]},"clock_id":{"type":"string","enum":["monotonic","wall"]},"source":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[^\\u0000-\\u001f\\u007f-\\u009f]+$"}}},
