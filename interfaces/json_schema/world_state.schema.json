              "presence": {"type":"object","additionalProperties":false,"required":["observed_at","confidence","evidence_refs","belief"],"properties":{"observed_at":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[^\\u0000-\\u001f\\u007f-\\u009f]+$"},"confidence":{"type":"number","minimum":0,"maximum":1},"evidence_refs":{"type":"array","minItems":1,"maxItems":32,"items":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[^\\u0000-\\u001f\\u007f-\\u009f]+$"}},"belief":{"type":"string","enum":["inferred","lost","observed","stale"]},"clock_id":{"type":"string","enum":["monotonic","wall"]},"source":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[^\\u0000-\\u001f\\u007f-\\u009f]+$"}}},
              "rack_state": {"type":"object","additionalProperties":false,"required":["observed_at","confidence","evidence_refs","belief"],"properties":{"observed_at":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[^\\u0000-\\u001f\\u007f-\\u009f]+$"},"confidence":{"type":"number","minimum":0,"maximum":1},"evidence_refs":{"type":"array","minItems":1,"maxItems":32,"items":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[^\\u0000-\\u001f\\u007f-\\u009f]+$"}},"belief":{"type":"string","enum":["inferred","lost","observed","stale"]},"clock_id":{"type":"string","enum":["monotonic","wall"]},"source":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[^\\u0000-\\u001f\\u007f-\\u009f]+$"}}},
              "slot_occupancy": {"type":"object","additionalProperties":false,"required":["observed_at","confidence","evidence_refs","belief"],"properties":{"observed_at":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[^\\u0000-\\u001f\\u007f-\\u009f]+$"},"confidence":{"type":"number","minimum":0,"maximum":1},"evidence_refs":{"type":"array","minItems":1,"maxItems":32,"items":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[^\\u0000-\\u001f\\u007f-\\u009f]+$"}},"belief":{"type":"string","enum":["inferred","lost","observed","stale"]},"clock_id":{"type":"string","enum":["monotonic","wall"]},"source":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[^\\u0000-\\u001f\\u007f-\\u009f]+$"}}},
              "slot_state": {"type":"object","additionalProperties":false,"required":["observed_at","confidence","evidence_refs","belief"],"properties":{"observed_at":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[^\\u0000-\\u001f\\u007f-\\u009f]+$"},"confidence":{"type":"number","minimum":0,"maximum":1},"evidence_refs":{"type":"array","minItems":1,"maxItems":32,"items":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[^\\u0000-\\u001f\\u007f-\\u009f]+$"}},"belief":{"type":"string","enum":["inferred","lost","observed","stale"]},"clock_id":{"type":"string","enum":["monotonic","wall"]},"source":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[^\\u0000-\\u001f\\u007f-\\u009f]+$"}}},
              "tracking_id": {"type":"object","additionalProperties":false,"required":["observed_at","confidence","evidence_refs","belief"],"properties":{"observed_at":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[^\\u0000-\\u001f\\u007f-\\u009f]+$"},"confidence":{"type":"number","minimum":0,"maximum":1},"evidence_refs":{"type":"array","minItems":1,"maxItems":32,"items":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[^\\u0000-\\u001f\\u007f-\\u009f]+$"}},"belief":{"type":"string","enum":["inferred","lost","observed","stale"]},"clock_id":{"type":"string","enum":["monotonic","wall"]},"source":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[^\\u0000-\\u001f\\u007f-\\u009f]+$"}}}
            }
          }
        },
        "allOf": [
          {"if": {"required": ["attributes"]}, "then": {"required": ["attributes_schema_version"]}},
          {"if": {"required": ["attributes_schema_version"]}, "then": {"required": ["attributes"]}},
          {"if": {"required": ["attribute_metadata"]}, "then": {"required": ["attributes"]}},
          {
            "if": {
              "required": ["attributes_schema_version"],
              "properties": {"attributes_schema_version": {"const": "observed-attributes-v1"}}
            },
            "then": {"required": ["attribute_metadata"]}
          }
        ]
      }
