{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScenarioManifest",
  "type": "object",
  "required": ["scenario_id", "seed", "task_id", "world_version", "fault_type", "timeout_s", "oracle_allowed"],
  "properties": {
    "scenario_id": {"type": "string"},
    "seed": {"type": "integer"},
    "task_id": {"type": "string"},
    "world_version": {"type": "string"},
    "fault_type": {
      "type": "string",
      "enum": [
        "actuator_timeout",
        "camera_dropout",
        "grasp_failure",
        "moving_target",
        "occlusion",
        "stale_observation",
        "none"
      ]
    },
    "timeout_s": {"type": "integer", "minimum": 1, "maximum": 600},
    "oracle_allowed": {"type": "boolean"}
  }
}
