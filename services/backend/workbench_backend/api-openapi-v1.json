{
  "openapi": "3.1.0",
  "info": {
    "title": "Workbench Desk Robot read-only API",
    "version": "1.0.0",
    "description": "Read-only run, event, health, alert, readiness, and expression projections. No endpoint grants robot or ROS control authority."
  },
  "servers": [{"url": "/"}],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "health",
        "responses": {"200": {"description": "Process is responding.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Health"}}}}}
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readiness",
        "responses": {
          "200": {"description": "Event source is readable.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Readiness"}}}},
          "503": {"description": "Not ready: the event source is unavailable or malformed, or the instance is draining.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/api/v1/openapi.json": {
      "get": {"operationId": "apiContract", "responses": {"200": {"description": "This contract.", "content": {"application/json": {"schema": {"type": "object"}}}}}}
    },
    "/api/v1/runs": {
      "get": {
        "operationId": "listRuns",
        "summary": "Ordered run summaries with scenario identity, outcome, evidence, bounded filters and pagination.",
        "description": "Read-only. Each run carries the registry scenario identity resolved through the committed legacy task_id mapping, the verifier outcome, and the evidence chain state. An unmapped task_id reports source unresolved with a null scenario_id rather than a guessed identity. A filter value outside the reported facet list is refused with 400 rather than silently ignored, and unfiltered_count is reported alongside total so a filtered page cannot read as the whole set.",
        "parameters": [
          {"$ref": "#/components/parameters/ScenarioId"},
          {"$ref": "#/components/parameters/ScenarioVersion"},
          {"$ref": "#/components/parameters/Outcome"},
          {"$ref": "#/components/parameters/Evidence"},
          {"$ref": "#/components/parameters/RunPage"},
          {"$ref": "#/components/parameters/RunPageSize"}
        ],
        "responses": {
          "200": {"description": "Run summaries. With no filter and no page the response is the unbounded RunList envelope; with a filter or a page it is the BoundedRunList envelope carrying total, unfiltered_count, max_page_size and the facet lists.", "content": {"application/json": {"schema": {"oneOf": [{"$ref": "#/components/schemas/BoundedRunList"}, {"$ref": "#/components/schemas/RunList"}]}}}},
          "400": {"description": "A filter value is outside the run set's facet list, or page/page_size is unusable. The value is refused rather than ignored.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "503": {"description": "The instance is draining, at its concurrency bound, or the event source is invalid.", "headers": {"Retry-After": {"description": "Seconds to wait before retrying; present when the refusal is transient.", "schema": {"type": "integer", "minimum": 1}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/api/v1/runs/{run_id}/timeline": {
      "get": {
        "operationId": "getRunTimeline",
        "summary": "Sequence-ordered evidence timeline for one run.",
        "description": "Read-only. Every item carries exactly one phase from execution, observation, verification, recovery or context, in the committed sequence_no order. Context events are kept but are never presented as verification of anything, and the projection is bounded by the same event ceiling as the event stream.",
        "parameters": [{"$ref": "#/components/parameters/RunId"}],
        "responses": {
          "200": {"description": "Bounded, sequence-ordered timeline.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RunTimeline"}}}},
          "400": {"description": "Invalid run identifier.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "404": {"description": "Run does not exist.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "413": {"description": "Response exceeds 4 MiB.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "503": {"description": "The instance is draining, at its concurrency bound, or the event source is invalid.", "headers": {"Retry-After": {"description": "Seconds to wait before retrying; present when the refusal is transient.", "schema": {"type": "integer", "minimum": 1}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/api/v1/runs/{run_id}": {
      "get": {
        "operationId": "getRun",
        "parameters": [{"$ref": "#/components/parameters/RunId"}],
        "responses": {
          "200": {"description": "Run summary.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RunDetail"}}}},
          "400": {"description": "Identifier is empty or outside the allowed character set.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "404": {"description": "Run does not exist.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "413": {"description": "Response exceeds 4 MiB.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "503": {"description": "The instance is draining, at its concurrency bound, or the event source is invalid.", "headers": {"Retry-After": {"description": "Seconds to wait before retrying; present when the refusal is transient.", "schema": {"type": "integer", "minimum": 1}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/api/v1/runs/{run_id}/events": {
      "get": {
        "operationId": "getRunEvents",
        "parameters": [{"$ref": "#/components/parameters/RunId"}],
        "responses": {
          "200": {"description": "Run summary and contiguous events.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RunEvents"}}}},
          "400": {"description": "Invalid run identifier.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "404": {"description": "Run does not exist.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "413": {"description": "Response exceeds 4 MiB.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "503": {"description": "The instance is draining, at its concurrency bound, or the event source is invalid.", "headers": {"Retry-After": {"description": "Seconds to wait before retrying; present when the refusal is transient.", "schema": {"type": "integer", "minimum": 1}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Current robot health, active alerts, and history bounds.",
        "description": "Read-only. Status and alerts are derived from validated monotonic snapshots; missing data is unknown or degraded, never healthy or zero. It cannot clear an alarm, reset a fault, release contactors, or move the robot.",
        "responses": {
          "200": {"description": "Current health projection.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HealthReport"}}}},
          "413": {"description": "Response exceeds 4 MiB.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "503": {"description": "The instance is draining, at its concurrency bound, or the health document is malformed.", "headers": {"Retry-After": {"description": "Seconds to wait before retrying; present when the refusal is transient.", "schema": {"type": "integer", "minimum": 1}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/api/v1/health/history": {
      "get": {
        "operationId": "getHealthHistory",
        "summary": "Bounded recent snapshot history and cleared alerts.",
        "description": "Read-only. Returns at most the configured snapshot, entry and age limits; safety-incident evidence is referenced rather than dropped.",
        "parameters": [{"$ref": "#/components/parameters/HistorySince"}],
        "responses": {
          "200": {"description": "Bounded history projection.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HealthHistory"}}}},
          "400": {"description": "The since filter is not a finite non-negative number.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "413": {"description": "Response exceeds 4 MiB.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "503": {"description": "The instance is draining, at its concurrency bound, or the health document is malformed.", "headers": {"Retry-After": {"description": "Seconds to wait before retrying; present when the refusal is transient.", "schema": {"type": "integer", "minimum": 1}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/api/v1/expression-states": {
      "get": {"operationId": "expressionContract", "responses": {"200": {"description": "Expression states and transitions.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ExpressionContract"}}}}, "503": {"description": "The instance is draining, at its concurrency bound, or the event source is invalid.", "headers": {"Retry-After": {"description": "Seconds to wait before retrying; present when the refusal is transient.", "schema": {"type": "integer", "minimum": 1}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}
    }
  },
  "components": {
    "parameters": {
      "HistorySince": {
        "name": "since",
        "in": "query",
        "required": false,
        "description": "Only report snapshots and cleared alerts at or after this monotonic timestamp (seconds).",
        "schema": {"type": "number", "minimum": 0}
      },
      "ScenarioId": {
      "name": "scenario_id",
      "in": "query",
      "required": false,
      "description": "Only report runs whose registry scenario id is this value. A value outside the reported facet list is refused with 400.",
      "schema": {"type": "string", "maxLength": 128}
    },
    "ScenarioVersion": {
      "name": "scenario_version",
      "in": "query",
      "required": false,
      "description": "Only report runs whose scenario version is this value.",
      "schema": {"type": "string", "maxLength": 32}
    },
    "Outcome": {
      "name": "outcome",
      "in": "query",
      "required": false,
      "description": "Only report runs whose verifier outcome is this value. none means no verifier ran; it is not a verdict.",
      "schema": {"enum": ["confirmed", "refuted", "insufficient_evidence", "none", "running"]}
    },
    "Evidence": {
      "name": "evidence",
      "in": "query",
      "required": false,
      "description": "Only report runs whose evidence chain state is this value. failed is a refutation the run ended on; not_executed is a run that ended with no verifier.",
      "schema": {"enum": ["confirmed", "refuted", "insufficient_evidence", "failed", "not_executed", "running"]}
    },
    "RunPage": {
      "name": "page",
      "in": "query",
      "required": false,
      "description": "1-based page of the filtered run list.",
      "schema": {"type": "integer", "minimum": 1, "default": 1}
    },
    "RunPageSize": {
      "name": "page_size",
      "in": "query",
      "required": false,
      "description": "Runs per page. Bounded so one request cannot ask for an unbounded projection.",
      "schema": {"type": "integer", "minimum": 1, "maximum": 200, "default": 200}
    },
    "RunId": {
        "name": "run_id",
        "in": "path",
        "required": true,
        "description": "1-128 ASCII letters, digits, dot, underscore, colon, or hyphen.",
        "schema": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {"error": {"type": "string"}, "message": {"type": "string"}, "run_id": {"type": "string"}}
      },
      "Health": {
        "type": "object",
        "required": ["status", "service", "version"],
        "properties": {"status": {"const": "ok"}, "service": {"type": "string"}, "version": {"type": "string"}}
      },
      "Readiness": {
        "type": "object",
        "required": ["status", "data_source"],
        "properties": {"status": {"enum": ["ready", "not_ready"]}, "data_source": {"type": "string"}}
      },
      "Event": {
        "type": "object",
        "required": ["event_id", "run_id", "sequence_no", "event_type", "occurred_at", "payload"],
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "run_id": {"type": "string", "minLength": 1},
          "sequence_no": {"type": "integer", "minimum": 0},
          "event_type": {"type": "string", "minLength": 1},
          "occurred_at": {"type": "string", "minLength": 1},
          "payload": {"type": "object"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }
      },
      "RunSummary": {
        "type": "object",
        "required": ["run_id", "status", "expression", "event_count", "visible_event_count", "safety"],
        "properties": {
          "run_id": {"type": "string"},
          "status": {"type": "string"},
          "expression": {"enum": ["idle", "thinking", "uncertain", "pleased"]},
          "event_count": {"type": "integer", "minimum": 1},
          "visible_event_count": {"type": "integer", "minimum": 1},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "task_id": {"type": "string"},
          "scenario_id": {"type": ["string", "null"], "description": "Null when the legacy task_id has no registry manifest. The projection never guesses an identity."},
          "scenario_version": {"type": ["string", "null"]},
          "scenario_label": {"type": ["string", "null"], "description": "The registry identity, for example kit-three-parts@0.2."},
          "scenario_source": {"enum": ["registry", "unresolved"]},
          "outcome": {"enum": ["confirmed", "refuted", "insufficient_evidence", "none", "running"], "description": "The verifier's verdict. none means no verifier ran."},
          "evidence": {"enum": ["confirmed", "refuted", "insufficient_evidence", "failed", "not_executed", "running"], "description": "The evidence chain state, which is a different question from the outcome: a recovered run stays refuted here while its outcome reports confirmed."},
          "recovery_count": {"type": "integer", "minimum": 0},
          "safety": {"type": "object", "required": ["hardware_estop", "software_control"]}
        },
        "additionalProperties": true
      },
      "RunFacets": {
        "type": "object",
        "required": ["scenario_id", "scenario_version", "outcome", "evidence"],
        "description": "The bounded, sorted values this run set actually contains. A filter UI builds its options from these, so it cannot offer a value that matches nothing and the response cannot grow with the run count.",
        "properties": {
          "scenario_id": {"type": "array", "maxItems": 64, "items": {"type": "string"}},
          "scenario_version": {"type": "array", "maxItems": 64, "items": {"type": "string"}},
          "outcome": {"type": "array", "maxItems": 64, "items": {"type": "string"}},
          "evidence": {"type": "array", "maxItems": 64, "items": {"type": "string"}}
        }
      },
      "TimelineItem": {
        "type": "object",
        "required": ["event_id", "sequence_no", "event_type", "phase", "occurred_at", "payload"],
        "properties": {
          "event_id": {"type": "string"},
          "sequence_no": {"type": "integer", "minimum": 0},
          "event_type": {"type": "string"},
          "phase": {"enum": ["execution", "observation", "verification", "recovery", "context"], "description": "Exactly one phase per item. Anything that is not evidence is context and is never rendered as verification."},
          "occurred_at": {"type": "string"},
          "payload": {"type": "object"},
          "evidence_refs": {"type": "array", "maxItems": 256, "items": {"type": "string"}}
        }
      },
      "RunTimeline": {
        "type": "object",
        "required": ["run_id", "timeline", "max_events_per_run", "read_only"],
        "properties": {
          "run_id": {"type": "string"},
          "timeline": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/components/schemas/TimelineItem"}},
          "max_events_per_run": {"type": "integer", "minimum": 1},
          "read_only": {"const": true}
        }
      },
      "RunList": {
        "type": "object",
        "required": ["runs", "read_only"],
        "description": "The unbounded envelope, returned when the request asks for no filter and no page. It is the shape the split-host controller already reads, so it is kept exact rather than grown.",
        "properties": {
          "runs": {"type": "array", "items": {"$ref": "#/components/schemas/RunSummary"}},
          "read_only": {"const": true}
        }
      },
      "BoundedRunList": {
        "type": "object",
        "required": ["runs", "total", "unfiltered_count", "page", "page_size", "max_page_size", "facets", "read_only"],
        "description": "The bounded envelope, returned when a filter or a page is requested. total and unfiltered_count travel together so a filtered page cannot read as the whole set.",
        "properties": {
          "runs": {"type": "array", "maxItems": 200, "items": {"$ref": "#/components/schemas/RunSummary"}},
          "total": {"type": "integer", "minimum": 0, "description": "Runs matching the filters, before pagination."},
          "unfiltered_count": {"type": "integer", "minimum": 0, "description": "Every readable run, so a filtered page cannot read as the whole set."},
          "page": {"type": "integer", "minimum": 1},
          "page_size": {"type": "integer", "minimum": 1, "maximum": 200},
          "max_page_size": {"type": "integer", "minimum": 1, "maximum": 200},
          "facets": {"$ref": "#/components/schemas/RunFacets"},
          "filters": {"type": "object", "description": "The filters that were applied, echoed so a response is self-describing."},
          "read_only": {"const": true}
        }
      },
      "RunDetail": {
        "type": "object",
        "required": ["run"],
        "properties": {"run": {"$ref": "#/components/schemas/RunSummary"}}
      },
      "RunEvents": {
        "type": "object",
        "required": ["run", "events"],
        "properties": {
          "run": {"$ref": "#/components/schemas/RunSummary"},
          "events": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/components/schemas/Event"}}
        }
      },
      "HealthStatus": {"enum": ["healthy", "degraded", "fault", "unknown"]},
      "HealthMetric": {
        "type": "object",
        "required": ["name", "unit", "expected_source", "state", "source_status", "missing", "stale"],
        "properties": {
          "name": {"type": "string", "description": "Registry metric name."},
          "value": {"type": ["boolean", "integer", "number", "string", "null"], "description": "Validated value; null when missing or in conflict."},
          "unit": {"type": "string"},
          "expected_source": {"type": "string", "description": "The only source permitted to write this metric."},
          "source": {"type": ["string", "null"]},
          "observed_at": {"type": ["number", "null"], "description": "Monotonic seconds; null when missing."},
          "age_s": {"type": ["number", "null"], "minimum": 0, "description": "Monotonic age in seconds; null when missing."},
          "state": {"enum": ["fresh", "degraded", "fault", "stale", "conflict", "missing"]},
          "source_status": {"enum": ["available", "stale", "missing", "conflict"]},
          "missing": {"type": "boolean"},
          "stale": {"type": "boolean"}
        }
      },
      "HealthDomain": {
        "type": "object",
        "required": ["status", "metrics"],
        "properties": {
          "status": {"$ref": "#/components/schemas/HealthStatus"},
          "metrics": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/components/schemas/HealthMetric"}}
        }
      },
      "HealthSnapshot": {
        "type": "object",
        "required": ["collected_at", "clock_id", "overall", "domains"],
        "properties": {
          "collected_at": {"type": "number", "minimum": 0, "description": "Monotonic seconds when the snapshot was taken."},
          "clock_id": {"const": "monotonic"},
          "overall": {"$ref": "#/components/schemas/HealthStatus"},
          "domains": {"type": "object", "maxProperties": 128, "additionalProperties": {"$ref": "#/components/schemas/HealthDomain"}}
        }
      },
      "HealthAlert": {
        "type": "object",
        "required": ["alert_id", "condition", "severity", "state", "metric", "domain", "first_seen_at", "last_seen_at", "count", "evidence_ref", "rules_version"],
        "properties": {
          "alert_id": {"type": "string", "description": "Stable metric:condition:source identity used for deduplication."},
          "condition": {"enum": ["estop_unavailable", "estop_disagreement", "watchdog_loss", "bms_fault", "contactor_denied", "can_bus_off", "can_link_loss", "controller_fault", "stop_fault", "localization_stale", "perception_stale", "event_store_integrity", "backend_unavailable", "disk_pressure", "source_missing", "source_stale", "source_fault"]},
          "severity": {"enum": ["info", "warning", "critical"]},
          "state": {"enum": ["active", "cleared"]},
          "metric": {"type": "string"},
          "domain": {"type": "string"},
          "source_status": {"type": "string"},
          "observed_value": {"type": ["boolean", "integer", "number", "string", "null"]},
          "unit": {"type": "string"},
          "first_seen_at": {"type": "number", "minimum": 0},
          "last_seen_at": {"type": "number", "minimum": 0},
          "count": {"type": "integer", "minimum": 1},
          "evidence_ref": {"type": "string"},
          "summary": {"type": "string"},
          "rules_version": {"const": "robot-alerts-v1"}
        }
      },
      "AlertSummary": {
        "type": "object",
        "required": ["total", "by_severity"],
        "properties": {
          "total": {"type": "integer", "minimum": 0},
          "by_severity": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
          "by_condition": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
          "rules_version": {"const": "robot-alerts-v1"}
        }
      },
      "HealthLimits": {
        "type": "object",
        "required": ["max_snapshots", "max_history_entries", "max_history_age_s", "max_document_bytes"],
        "properties": {
          "max_snapshots": {"type": "integer", "minimum": 1, "maximum": 256},
          "max_history_entries": {"type": "integer", "minimum": 1, "maximum": 512},
          "max_history_age_s": {"type": "number", "maximum": 86400},
          "max_document_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}
        }
      },
      "HealthHistoryBounds": {
        "type": "object",
        "required": ["snapshot_count", "limits"],
        "properties": {
          "snapshot_count": {"type": "integer", "minimum": 0, "maximum": 256},
          "oldest_collected_at": {"type": ["number", "null"]},
          "newest_collected_at": {"type": ["number", "null"]},
          "limits": {"$ref": "#/components/schemas/HealthLimits"}
        }
      },
      "HealthReport": {
        "type": "object",
        "required": ["read_only", "status", "source", "current", "alerts", "history", "integrity"],
        "properties": {
          "read_only": {"const": true},
          "rules_version": {"const": "robot-alerts-v1"},
          "history_version": {"const": "backend-health-history-v1"},
          "status": {"$ref": "#/components/schemas/HealthStatus"},
          "source": {"type": "string"},
          "current": {"anyOf": [{"$ref": "#/components/schemas/HealthSnapshot"}, {"type": "null"}]},
          "alerts": {
            "type": "object",
            "required": ["summary", "active"],
            "properties": {
              "summary": {"$ref": "#/components/schemas/AlertSummary"},
              "active": {"type": "array", "maxItems": 256, "items": {"$ref": "#/components/schemas/HealthAlert"}}
            }
          },
          "history": {"$ref": "#/components/schemas/HealthHistoryBounds"},
          "integrity": {
            "type": "object",
            "required": ["malformed_documents", "source_restarts"],
            "properties": {"malformed_documents": {"type": "integer", "minimum": 0}, "source_restarts": {"type": "integer", "minimum": 0}}
          },
          "reason": {"type": "string"}
        }
      },
      "HealthHistoryEntry": {
        "type": "object",
        "required": ["collected_at", "clock_id", "overall", "domains"],
        "properties": {
          "collected_at": {"type": "number", "minimum": 0},
          "clock_id": {"const": "monotonic"},
          "overall": {"$ref": "#/components/schemas/HealthStatus"},
          "domains": {"type": "object", "additionalProperties": {"$ref": "#/components/schemas/HealthStatus"}}
        }
      },
      "HealthHistory": {
        "type": "object",
        "required": ["read_only", "source", "snapshots", "cleared_alerts", "limits"],
        "properties": {
          "read_only": {"const": true},
          "rules_version": {"const": "robot-alerts-v1"},
          "history_version": {"const": "backend-health-history-v1"},
          "source": {"type": "string"},
          "snapshots": {"type": "array", "maxItems": 256, "items": {"$ref": "#/components/schemas/HealthHistoryEntry"}},
          "cleared_alerts": {"type": "array", "maxItems": 512, "items": {"$ref": "#/components/schemas/HealthAlert"}},
          "limits": {"$ref": "#/components/schemas/HealthLimits"}
        }
      },
      "ExpressionContract": {
        "type": "object",
        "required": ["states", "transitions"],
        "properties": {
          "states": {"type": "array", "items": {"enum": ["idle", "thinking", "uncertain", "pleased"]}},
          "transitions": {"type": "object"}
        }
      }
    }
  },
  "x-compatibility": {
    "current": "/api/v1",
    "legacy_alias": "/api",
    "policy": "v1 is additive and read-only; aliases remain until a documented v2 migration."
